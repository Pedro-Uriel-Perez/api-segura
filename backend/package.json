{
  "name": "secure-task-manager-api",
  "version": "1.0.0",
  "description": "Secure Task Manager REST API (Express + PostgreSQL + Prisma)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "dotenv -e .env.test -- prisma migrate deploy && jest --runInBand",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ]
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1"
  }
}
